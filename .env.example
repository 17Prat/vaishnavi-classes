# FeeFlow Environment Configuration Example

# --- Database Configuration ---
# For local SQLite development (zero-config, out-of-the-box):
DATABASE_URL=sqlite+aiosqlite:///./feeflow.db

# For Neon PostgreSQL Cloud (Production / Free Tier):
# Copy your connection string from Neon Console (e.g. postgresql://user:password@ep-xyz.neon.tech/feeflow?sslmode=require)
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/feeflow?ssl=require

# --- Security & JWT ---
SECRET_KEY=feeflow-super-secret-jwt-key-change-in-production-2026-secure-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
